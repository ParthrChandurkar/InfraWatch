# Example root environment used by docker-compose and local scripts.
COMPOSE_PROJECT_NAME=infrawatch
POSTGRES_USER=infrawatch
POSTGRES_PASSWORD=change-this-in-your-local-env
POSTGRES_DB=infrawatch
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-this-in-your-local-env
VITE_API_BASE_URL=/api
INFRAWATCH_ALLOW_MOCK_OBSERVABILITY=true
REDIS_URL=redis://redis:6379/0
REDIS_CACHE_TTL=5

# Optional host ports. Change these if another local project already uses the defaults.
FRONTEND_PORT=3000
BACKEND_PORT=8000
POSTGRES_PORT=5432
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
LOKI_PORT=3100
ALLOY_PORT=12345
ALERTMANAGER_PORT=9093
